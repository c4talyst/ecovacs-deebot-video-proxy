# Ecovacs Account Credentials
ECOVACS_USERNAME="your-email@example.com"
ECOVACS_PASSWORD="your-ecovacs-password"
ECOVACS_COUNTRY="za"

# Persistent Client Authentication (Generated via setup helper)
ECOVACS_DEVICE_ID=""
ECOVACS_ACCESS_TOKEN=""
ECOVACS_USER_ID=""

# Optional: Camera / Video Manager PIN (leave blank if disabled in Ecovacs app)
ECOVACS_PIN=""

# Optional: Target specific robot DID (if you own multiple vacuums; leave blank for first robot)
ECOVACS_ROBOT_DID=""

# RTSP Stream Settings
RTSP_PATH="live"
RTSP_PORT=8554
RTSP_FPS=16
RTSP_BITRATE="1500k"

# Optional: Stream & Web Authentication (protects RTSP, WebRTC, HLS, HTTP Web UI, MJPEG)
RTSP_USERNAME=""
RTSP_PASSWORD=""
# Power-saving: Only enable video when Robot or Station is Active (turns off headlights when docked)
ACTIVE_ONLY_VIDEO="false"

# On-Stream Stats Overlay (OSD)
OVERLAY_ENABLED="true"
OVERLAY_SHOW_TIMESTAMP="true"
OVERLAY_SHOW_BATTERY="true"
OVERLAY_SHOW_MODE="true"
OVERLAY_SHOW_STATION="true"
OVERLAY_SHOW_MAINTENANCE="true"
OVERLAY_SHOW_ROBOT_NAME="true"
OVERLAY_POSITION="top_banner"

# Logging Level (INFO or DEBUG)
LOG_LEVEL="INFO"
# Optional: aiortc log level (defaults to INFO to suppress per-packet RTP spam)
AIORTC_LOG_LEVEL="INFO"
